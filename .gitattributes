# Store text files with LF in the repo and check them out as LF on every OS,
# so diffs stay clean and Go / Node / Docker tooling sees the same bytes.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch line endings, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.glb binary
*.exe binary
*.zip binary
