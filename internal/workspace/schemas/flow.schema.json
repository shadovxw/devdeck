{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devdeck.local/schemas/flow.schema.json",
  "title": "devdeck flow",
  "description": "flows/<name>.yaml: steps that run plugin actions in order. Structure only; the flow engine checks the actions themselves.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "steps"],
  "properties": {
    "version": { "const": 1, "description": "Schema version. Always 1 for now." },
    "name": { "$ref": "#/$defs/id" },
    "description": { "type": "string", "maxLength": 200 },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manual": { "type": "boolean" },
        "schedule": { "type": "string", "description": "A cron expression, such as 0 3 * * 1." },
        "work_item_stage": { "type": "string" }
      }
    },
    "for_each": { "enum": ["repo"], "description": "Run the whole flow once per repo." },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uses"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "uses": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9_-]*$",
          "description": "The plugin action to run, written plugin.action, such as gitleaks.scan."
        },
        "inputs": { "type": "object", "description": "Inputs for the action." },
        "needs": { "type": "array", "uniqueItems": true, "items": { "type": "string" }, "description": "Ids of steps that must finish first." },
        "gate": { "type": "string", "description": "An expression that must be true for the flow to continue." },
        "approval": { "type": "boolean", "description": "Ask the user before running this step." },
        "timeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m)$" },
        "retries": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    }
  }
}
